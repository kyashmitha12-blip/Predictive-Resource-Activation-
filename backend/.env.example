# Copy to backend/.env for local development. NEVER commit real values.
ENV=development                # development | test | production
DATABASE_URL=postgresql://postgres:lendloop123@localhost:5432/lendloop
# Required in production (32+ chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-change-me-in-production
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_CORS_ORIGINS=
SESSION_TTL_HOURS=12
COOKIE_SAMESITE=lax            # use "none" only if frontend and API are on different sites (requires HTTPS)
TRUST_PROXY=false              # true behind Render/Railway
RATE_LIMIT_ENABLED=true

# File storage: local | s3 (any S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email. Leave SMTP_HOST empty ONLY in development: links are then shown in the UI and no email is sent.
# In production SMTP_HOST must be set; links are never returned by the API when ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Predictive Resource Activation <no-reply@example.com>

DEMO_PAYMENTS=true             # payments are simulated and labelled DEMO
